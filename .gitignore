# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Local caches (D:-drive only for HF/torch/temp)
.cache/

# Data (large, downloaded)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated outputs
# NOTE: only the trained Spatial CBM checkpoint ships with the app so that
# hosted deployments (Streamlit Cloud) work out of the box without training.
outputs/*
!outputs/.gitkeep
!outputs/chestxdet_fasttrack/
outputs/chestxdet_fasttrack/*
!outputs/chestxdet_fasttrack/checkpoints/
outputs/chestxdet_fasttrack/checkpoints/*
!outputs/chestxdet_fasttrack/checkpoints/spatial_cbm/
outputs/chestxdet_fasttrack/checkpoints/spatial_cbm/*
!outputs/chestxdet_fasttrack/checkpoints/spatial_cbm/best_model.pth

# Splits are generated reproducibly by scripts/prepare_data.py
data/splits/*
!data/splits/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.lnk

# Notebooks checkpoints
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# Logs
*.log
